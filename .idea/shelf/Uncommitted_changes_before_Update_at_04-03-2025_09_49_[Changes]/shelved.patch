+    "# State your solution here. Add more cells if needed.\n",
+    "import pandas as pd\n",
+    "import seaborn as sns\n",
+    "import matplotlib.pyplot as plt\n",
+    "\n",
+    "# Load the dataset\n",
+    "file_path = \"listings.xlsx\"  # Ensure this file is in your working directory\n",
+    "df = pd.read_excel(file_path)\n",
+    "\n",
+    "# Step 1: Check if necessary columns exist\n",
+    "if 'neighbourhood' in df.columns and 'price' in df.columns:\n",
+    "    \n",
+    "    # Step 2: Compute median price for each neighborhood\n",
+    "    neighbourhood_median_price = df.groupby('neighbourhood')['price'].median().sort_values(ascending=False)\n",
+    "    \n",
+    "    # Step 3: Sort neighborhoods by median price\n",
+    "    sorted_neighbourhoods = neighbourhood_median_price.index\n",
+    "\n",
+    "    # Step 4: Plot boxplot for price distribution across sorted neighborhoods\n",
+    "    plt.figure(figsize=(15, 6))\n",
+    "    sns.boxplot(x=df['neighbourhood'], y=df['price'], order=sorted_neighbourhoods)\n",
+    "    plt.xticks(rotation=90)\n",
+    "    plt.xlabel(\"Neighbourhood\")\n",
+    "    plt.ylabel(\"Price (DKK)\")\n",
+    "    plt.title(\"Price Distribution Across Copenhagen Neighbourhoods (Sorted by Median Price)\")\n",
+    "    plt.ylim(0, df['price'].quantile(0.95))  # Remove extreme outliers\n",
+    "    plt.show()\n",
+    "\n",
+    "    # Step 5: Boxplots for other variables across neighborhoods\n",
+    "    variables_to_plot = [\"number_of_reviews\", \"availability_365\"]\n",
+    "    \n",
+    "    for variable in variables_to_plot:\n",
+    "        if variable in df.columns:\n",
+    "            plt.figure(figsize=(15, 6))\n",
+    "            sns.boxplot(x=df['neighbourhood'], y=df[variable], order=sorted_neighbourhoods)\n",
+    "            plt.xticks(rotation=90)\n",
+    "            plt.xlabel(\"Neighbourhood\")\n",
+    "            plt.ylabel(variable.replace(\"_\", \" \").title())  # Format label\n",
+    "            plt.title(f\"{variable.replace('_', ' ').title()} Distribution Across Copenhagen Neighbourhoods\")\n",
+    "            plt.ylim(0, df[variable].quantile(0.95))  # Remove extreme outliers\n",
+    "            plt.show()\n",
+    "        else:\n",
+    "            print(f\"The column '{variable}' was not found in the dataset.\")\n",
+    "\n",
+    "else:\n",
+    "    print(\"The required columns 'neighbourhood' and 'price' were not found in the dataset.\")\n"
